{
  "version": 1,
  "ollama": {
    "url": "http://localhost:11434",
    "embedding_model": "nomic-embed-text",
    "auxiliary_model": "gemma4:e4b"
  },
  "database": {
    "path": "graph/code_graph.db"
  },
  "targets": [
    {
      "type": "typescript",
      "name": "CC_USAGE_DASHBOARD",
      "root": "C:\\Private_repositories\\CC_usage_dashboard",
      "output": "graph/CC_USAGE_DASHBOARD_graph.json",
      "include": [
        "*.ts"
      ],
      "exclude": [
        "**/node_modules/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.d.ts"
      ],
      "max_depth": 10,
      "extract": {
        "imports": true,
        "exports": true,
        "functions": true,
        "calls": true,
        "classes": false,
        "types": true
      },
      "resolve": {
        "extensions": [
          ".ts",
          ".tsx",
          "/index.ts",
          "/index.tsx"
        ],
        "tsconfig": null,
        "alias": {}
      },
      "labels": []
    }
  ]
}